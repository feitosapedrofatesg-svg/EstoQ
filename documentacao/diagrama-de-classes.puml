@startuml
' ============================================================
' estoQ — Diagrama de Classes
' Sistema de Gestão de Estoque e CMV para Cozinha (modelo idealizado)
' Nível: aluno do 3º período de Análise e Desenvolvimento de Sistemas
' ============================================================

skinparam classAttributeIconSize 0
skinparam classFontSize 13
title estoQ — Diagrama de Classes (controle de estoque por lotes e movimentações)

' ------------------------------------------------------------
' Pacote: core (camada genérica/infraestrutura)
' ------------------------------------------------------------
package "core (Infraestrutura genérica)" {

    abstract class BaseModel {
        - id : UUID
        - dataHoraCriacao : LocalDateTime
        - ativo : boolean
        + prePersist() : void
    }

    abstract class BaseDTO {
        - id : UUID
        - ativo : boolean
        - dataHoraCriacao : LocalDateTime
    }

    interface IGenericRepository<E> <<interface>> {
        + findByIdAndAtivoTrue(id) : Optional<E>
        + findAllByAtivoTrue(pageable) : Page<E>
    }

    interface IGenericService<E, R, V> <<interface>> {
        + findByIdActive(id) : E
        + findAllActive(pageable) : Page<E>
        + insert(entity) : E
        + update(entity) : E
        + delete(id) : void
    }

    abstract class GenericService<E, R, V> {
        # repository : R
        # validation : V
        .. ganchos (hook methods) ..
        # beforeInsert(entity) : void
        # beforeUpdate(entity) : void
        # beforeDelete(entity) : void
    }

    abstract class GenericController<E, D, S, A> {
        # service : S
        # adapter : A
        + findById(id) : ResponseEntity
        + findAll(pageable) : ResponseEntity
        + insert(dto) : ResponseEntity
        + update(id, dto) : ResponseEntity
        + delete(id) : ResponseEntity
    }

    interface IGenericAdapter<E, D> <<interface>> {
        + toDto(entity) : D
        + toEntity(dto) : E
    }

    interface IGenericValidation<E, R> <<interface>> {
        + validateFields(entity) : void
    }

    ' relacionamentos do core
    GenericService ..|> IGenericService
    GenericService --> IGenericRepository : usa
    GenericService --> IGenericValidation : usa
    GenericController --> IGenericService : usa
    GenericController --> IGenericAdapter : usa
}

' ------------------------------------------------------------
' Pacote: business (Domínio)
' ------------------------------------------------------------
package "business (Domínio)" {

    ' --------- Bloco: Acesso ---------
    class UsuarioModel {
        - nome : String
        - pin : String
        - perfil : Perfil
    }

    class SessaoModel {
        - token : String
        - usuarioId : UUID
        - criadoEm : LocalDateTime
        - expiraEm : LocalDateTime
    }

    enum Perfil {
        ADMIN
        COZINHA
        NUTRICIONISTA
    }

    ' --------- Bloco: Cadastros ---------
    class CategoriaModel {
        - nome : String
        - descricao : String
    }

    class ProdutoModel {
        - nome : String
        - unidadeMedida : UnidadeMedida
        <<transient>> saldoAtual : BigDecimal
        <<transient>> estoqueMinimo : BigDecimal
        + estaAbaixoDoMinimo(minimo) : boolean
    }

    enum UnidadeMedida {
        KG
        G
        L
        ML
        UN
        PCT
        CARTELA
        CX
    }

    ' --------- Bloco: Movimentações ---------
    abstract class MovimentacaoEstoqueModel {
        - dataHora : LocalDateTime
        - quantidadeAnterior : BigDecimal
        - quantidadePosterior : BigDecimal
        - observacao : String
        + {abstract} getTipo() : TipoMovimentacao
    }

    class EntradaModel {
        - valorTotalPago : BigDecimal
        - unidadeCompra : UnidadeMedida
        - dataValidade : LocalDate
        - precoUnitario : BigDecimal
        + gerarLote(produto, data) : LoteModel
        + calcularPrecoUnitario() : BigDecimal
    }

    class ConsumoModel {
        - custoConsumo : BigDecimal
    }

    class DesperdicioModel {
        - motivo : MotivoDesperdicio
        - descricaoMotivo : String
        + getValorPrejuizo() : BigDecimal
    }

    class AjusteModel {
        - diferencaApurada : BigDecimal
        - justificativa : String
    }

    enum TipoMovimentacao {
        ENTRADA
        CONSUMO
        DESPERDICIO
        AJUSTE
    }

    enum MotivoDesperdicio {
        VENCIMENTO
        DETERIORACAO
        PREPARO_INCORRETO
        SOBRA_NAO_APROVEITADA
        OUTRO
    }

    class LoteModel {
        - codigo : String
        - quantidadeInicial : BigDecimal
        - quantidadeAtual : BigDecimal
        - dataEntrada : LocalDate
        - dataValidade : LocalDate
        - precoUnitario : BigDecimal
        + baixar(qtd) : void
        + creditar(qtd) : void
        + estaDisponivel() : boolean
        + estaVencido() : boolean
        + diasParaVencimento() : long
    }

    class ProdutoAbertoModel {
        - dataAbertura : LocalDateTime
        - quantidadeAberta : BigDecimal
        - quantidadeUtilizada : BigDecimal
        - finalizado : boolean
        + marcarFinalizado() : void
        + registrarSobra(qtd) : void
        + getQuantidadeRestante() : BigDecimal
    }

    ' --------- Bloco: Parâmetros e conferência ---------
    class ParametroEstoqueModel {
        - estoqueMinimo : BigDecimal
        - estoqueMedio : BigDecimal
        - estoqueMaximo : BigDecimal
        - consumoMedioDiario : BigDecimal
        - tempoReposicaoDias : Integer
        - periodoAnaliseDias : Integer
        - dataAtualizacao : LocalDateTime
        + recalcularNiveis(consumoMedio) : void
    }

    class ConfiguracaoBalancoModel {
        - periodicidade : PeriodicidadeBalanco
        - diaExecucao : Integer
        - proximaExecucao : LocalDate
        + calcularProximaExecucao(hoje, ultimo) : void
        + balancoEstaPendente(hoje, emAndamento) : boolean
    }

    class BalancoModel {
        - dataHora : LocalDateTime
        - tipo : PeriodicidadeBalanco
        - status : StatusBalanco
        + apurarDiferencas() : void
        + confirmar() : void
    }

    class ItemBalancoModel {
        - quantidadeSistema : BigDecimal
        - quantidadeFisica : BigDecimal
        - diferenca : BigDecimal
        + calcularDiferenca() : BigDecimal
    }

    enum PeriodicidadeBalanco {
        DIARIA
        SEMANAL
        MENSAL
    }

    enum StatusBalanco {
        PENDENTE
        EM_ANDAMENTO
        CONCLUIDO
    }

    ' --------- Bloco: Informação ---------
    class AlertaModel {
        - tipo : TipoAlerta
        - mensagem : String
        - dataGeracao : LocalDateTime
        - visualizado : boolean
        + marcarComoVisualizado() : void
    }

    enum TipoAlerta {
        ESTOQUE_BAIXO
        PROXIMO_VENCIMENTO
        VENCIDO
        BALANCO_PENDENTE
        DIFERENCA_ESTOQUE
    }

    class RelatorioModel {
        - tipo : TipoRelatorio
        - dataInicio : LocalDate
        - dataFim : LocalDate
        - dataGeracao : LocalDateTime
        - linhasGeradas : Integer
    }

    enum TipoRelatorio {
        ESTOQUE_ATUAL
        PROXIMO_VENCIMENTO
        VENCIDOS
        PRODUTOS_ABERTOS
        DESPERDICIO
        CONSUMO_MEDIO
    }

    ' Interfaces de repositório
    interface IUsuarioRepository <<interface>> {}
    interface ISessaoRepository <<interface>> {}
    interface ICategoriaRepository <<interface>> {}
    interface IProdutoRepository <<interface>> {
        + existsByNome(nome) : boolean
        + findByNomeIgnoreCase(nome) : Optional<ProdutoModel>
        + countByCategoriaIdAndAtivoTrue(catId) : long
    }
    interface ILoteRepository <<interface>> {
        + sumQuantidadeAtualByProdutoId(produtoId) : BigDecimal
        + findAllAtivoOrdenado() : List<LoteModel>
        + findAllDisponiveis() : List<LoteModel>
    }
    interface IMovimentacaoEstoqueRepository <<interface>> {
        + findConsumos(ini, fim) : List<MovimentacaoEstoqueModel>
        + findDesperdicios(ini, fim) : List<MovimentacaoEstoqueModel>
    }
    interface IProdutoAbertoRepository <<interface>> {
        + sumQuantidadeRestanteByProdutoId(produtoId) : BigDecimal
    }
    interface IParametroEstoqueRepository <<interface>> {}
    interface IConfiguracaoBalancoRepository <<interface>> {}
    interface IBalancoRepository <<interface>> {}
    interface IItemBalancoRepository <<interface>> {}
    interface IAlertaRepository <<interface>> {}
    interface IRelatorioRepository <<interface>> {}

    ' Serviços (regras de negócio)
    class UsuarioService
    class SessaoService
    class CategoriaService
    class ProdutoService {
        + obterSaldo(produto) : BigDecimal
        + obterEstoqueMinimo(produto) : BigDecimal
    }
    class LoteService
    class MovimentacaoService {
        + registrarEntrada(...) : MovimentacaoView
        + registrarConsumo(...) : MovimentacaoView
        + registrarDesperdicio(...) : MovimentacaoView
        + registrarAjuste(...) : MovimentacaoView
        + abrirEmbalagem(...) : ProdutoAbertoView
        + registrarSobra(...) : ProdutoAbertoView
        + obterSaldo(produtoId) : BigDecimal
        + custoMedioProduto(produtoId) : BigDecimal
        + reverterMovimentacao(id) : void
    }
    class ProdutoAbertoService
    class ParametroEstoqueService {
        + recalcular(produtoId) : ParametroEstoqueModel
        + contarProdutosComEstoqueBaixo() : long
    }
    class ConferenciaService {
        + iniciarBalanco(usuario) : BalancoView
        + atualizarQuantidadeFisica(...) : ItemBalancoView
        + apurar(id) : BalancoView
        + confirmar(id, usuario) : BalancoView
    }
    class AlertaService {
        + gerarAlertas() : int
        + marcarComoVisualizado(id) : void
    }
    class RelatorioService {
        + cmv(inicio, fim, vendas) : CMVReportDTO
        + gerarTipo(tipo, inicio, fim) : RelatorioViewDTO
        + dashboard(ano, mes) : DashboardDTO
    }

    ' Validações
    class CategoriaValidation {}
    class ProdutoValidation {}
    class UsuarioValidation {}

    ' ---- Herança das entidades no BaseModel ----
    UsuarioModel -up-|> BaseModel
    SessaoModel -up-|> BaseModel
    CategoriaModel -up-|> BaseModel
    ProdutoModel -up-|> BaseModel
    LoteModel -up-|> BaseModel
    MovimentacaoEstoqueModel -up-|> BaseModel
    EntradaModel -up-|> MovimentacaoEstoqueModel
    ConsumoModel -up-|> MovimentacaoEstoqueModel
    DesperdicioModel -up-|> MovimentacaoEstoqueModel
    AjusteModel -up-|> MovimentacaoEstoqueModel
    ProdutoAbertoModel -up-|> BaseModel
    ParametroEstoqueModel -up-|> BaseModel
    ConfiguracaoBalancoModel -up-|> BaseModel
    BalancoModel -up-|> BaseModel
    ItemBalancoModel -up-|> BaseModel
    AlertaModel -up-|> BaseModel
    RelatorioModel -up-|> BaseModel

    ' ---- Repositórios especializados herdam do genérico ----
    IUsuarioRepository ..|> IGenericRepository
    ISessaoRepository ..|> IGenericRepository
    ICategoriaRepository ..|> IGenericRepository
    IProdutoRepository ..|> IGenericRepository
    ILoteRepository ..|> IGenericRepository
    IMovimentacaoEstoqueRepository ..|> IGenericRepository
    IProdutoAbertoRepository ..|> IGenericRepository
    IParametroEstoqueRepository ..|> IGenericRepository
    IConfiguracaoBalancoRepository ..|> IGenericRepository
    IBalancoRepository ..|> IGenericRepository
    IItemBalancoRepository ..|> IGenericRepository
    IAlertaRepository ..|> IGenericRepository
    IRelatorioRepository ..|> IGenericRepository

    ' ---- Serviços especializados herdam do genérico ----
    CategoriaService -up-|> GenericService
    ProdutoService -up-|> GenericService

    ' ---- Relacionamentos (agregação/composição) ----
    ProdutoModel "1" *-- "0..*" LoteModel : tem
    ProdutoModel "1" *-- "0..*" ProdutoAbertoModel : tem
    ProdutoModel "1" *-- "0..*" MovimentacaoEstoqueModel : sofre
    MovimentacaoEstoqueModel "1" -> "1" UsuarioModel : executada por
    MovimentacaoEstoqueModel "1" -> "0..1" LoteModel : referencia
    ConsumoModel "1" -> "0..1" ProdutoAbertoModel : consome
    AjusteModel "1" -> "0..1" ItemBalancoModel : origem

    CategoriaModel "1" --> "0..*" ProdutoModel : classifica
    ProdutoModel "1" --> "0..1" ParametroEstoqueModel : parametriza

    BalancoModel "1" *-- "0..*" ItemBalancoModel : possui
    ItemBalancoModel "1" -> "1" ProdutoModel : confere
    BalancoModel "1" -> "1" UsuarioModel : responsável
    ConfiguracaoBalancoModel "1" --> "0..*" BalancoModel : agenda

    AlertaModel "1" -> "0..1" ProdutoModel : referencia
    AlertaModel "1" -> "0..1" LoteModel : referencia
    AlertaModel "1" -> "0..1" BalancoModel : referencia

    ' ---- Atributos/enums usados ----
    UsuarioModel ..> Perfil
    ProdutoModel ..> UnidadeMedida
    MovimentacaoEstoqueModel ..> TipoMovimentacao
    DesperdicioModel ..> MotivoDesperdicio
    BalancoModel ..> PeriodicidadeBalanco
    BalancoModel ..> StatusBalanco
    ConfiguracaoBalancoModel ..> PeriodicidadeBalanco
    AlertaModel ..> TipoAlerta
    RelatorioModel ..> TipoRelatorio

    ' ---- Serviços usam repositórios ----
    MovimentacaoService --> ILoteRepository : usa
    MovimentacaoService --> IProdutoAbertoRepository : usa
    MovimentacaoService --> IMovimentacaoEstoqueRepository : usa
    LoteService --> ILoteRepository : usa
    RelatorioService --> IMovimentacaoEstoqueRepository : usa
    AlertaService --> ILoteRepository : usa
    AlertaService --> IBalancoRepository : usa
    ConferenciaService --> IBalancoRepository : usa
    ConferenciaService --> IItemBalancoRepository : usa
}

' ------------------------------------------------------------
' Pacote: api (Controllers REST e DTOs de projeção)
' ------------------------------------------------------------
package "api (Controllers REST)" {

    class AuthController
    class UsuarioController
    class CategoriaController
    class ProdutoController
    class LoteController
    class MovimentacaoController
    class ProdutoAbertoController
    class ParametroEstoqueController
    class ConferenciaController
    class AlertaController
    class RelatorioController
    class IntegracaoController

    ' Herança dos controllers CRUD no genérico
    CategoriaController -up-|> GenericController
    ProdutoController -up-|> GenericController

    ' Usam os serviços de negócio
    AuthController --> UsuarioService : usa
    AuthController --> SessaoService : usa
    ProdutoController --> ProdutoService : usa
    CategoriaController --> CategoriaService : usa
    LoteController --> LoteService : usa
    MovimentacaoController --> MovimentacaoService : usa
    ProdutoAbertoController --> ProdutoAbertoService : usa
    ParametroEstoqueController --> ParametroEstoqueService : usa
    ConferenciaController --> ConferenciaService : usa
    AlertaController --> AlertaService : usa
    RelatorioController --> RelatorioService : usa
    IntegracaoController --> MovimentacaoService : usa
    IntegracaoController --> RelatorioService : usa
}

' ------------------------------------------------------------
' Pacote: integracao (importação/exportação de planilha/CSV)
' ------------------------------------------------------------
package "integracao (CSV)" {

    class ProdutoImportadorHelper {
        + criarProduto(nome, categoria, unidade) : ProdutoModel
        + listarProdutos() : List<ProdutoModel>
    }

    IntegracaoController ..> ProdutoImportadorHelper : usa
}

' ------------------------------------------------------------
' Legenda
' ------------------------------------------------------------
legend right
  | Símbolo | Significado |
  |---|---|
  | <--\|> | Herança (é um) |
  | ..\|> | Implementação de interface |
  | *-- | Agregação (tem) |
  | -->  | Dependência / uso |
endlegend

@enduml